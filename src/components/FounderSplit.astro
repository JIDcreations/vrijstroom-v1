---
// The entrepreneur: photo on one half, words on the other.
import { Picture } from 'astro:assets';
import { photo } from '../lib/images';
import Text from './Text.astro';
import Icon from './Icon.astro';
interface Props {
  title: string; name: string; paragraphs: string[]; quote: string;
  image: string; imageAlt: string; imageNote?: string;
  link?: { label: string; href: string };
  headingLevel?: 'h2' | 'h3';
}
const { title, name, paragraphs, quote, image, imageAlt, imageNote = 'Voorbeeldbeeld, geen foto van de ondernemer', link } = Astro.props;
---
<section class="founder on-dark" aria-labelledby="founder-title">
  <div class="founder__grid">
    <figure class="founder__media" data-placeholder={imageNote}>
      <Picture src={photo(image)} alt={imageAlt} formats={['avif', 'webp']} widths={[400, 577]} sizes="(min-width: 860px) 45vw, 100vw" />
    </figure>
    <div class="founder__copy" data-reveal>
      <h2 id="founder-title">{title}</h2>
      <p class="founder__name"><Text text={name} /></p>
      {paragraphs.map((p) => <p class="founder__p"><Text text={p} /></p>)}
      <blockquote><Text text={quote} /></blockquote>
      {link && <a class="link-arrow" href={link.href}>{link.label}<Icon name="arrow-right" size={20} /></a>}
    </div>
  </div>
</section>

<style>
  .founder { background: var(--dark); color: var(--sand); }
  .founder__grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; }
  .founder__media { margin: 0; aspect-ratio: 4 / 5; max-height: 820px; width: 100%; overflow: hidden; }
  .founder__media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 35%; }
  .founder__copy { display: grid; gap: 18px; justify-items: start; padding: clamp(48px, 7vw, 112px) var(--gutter); max-width: 620px; }
  .founder h2 { font-size: clamp(1.75rem, 3.2vw, 2.625rem); }
  .founder__name { font-weight: 600; }
  .founder__p { color: var(--muted-on-dark); }
  .founder blockquote { margin: 8px 0; padding-left: 20px; border-left: 3px solid var(--green); font-family: var(--font-display); font-size: 1.25rem; line-height: 1.35; }
  @media (max-width: 859px) {
    .founder__grid { grid-template-columns: 1fr; }
    .founder__media { aspect-ratio: 4 / 3; }
  }
</style>
