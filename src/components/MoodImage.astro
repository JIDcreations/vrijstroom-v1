---
// Full-width photo with one line of text, fading into Dark nature below.
import { Picture } from 'astro:assets';
import { photo } from '../lib/images';
interface Props { line: string; image: string; imageAlt: string; imageNote?: string }
const { line, image, imageAlt, imageNote = 'Sfeerbeeld (stock)' } = Astro.props;
---
<section class="mood" aria-label={line}>
  <figure class="mood__media" data-placeholder={imageNote}>
    <Picture src={photo(image)} alt={imageAlt} formats={['avif', 'webp']} widths={[640, 960, 1440, 1920]} sizes="100vw" />
  </figure>
  <p class="container mood__line">{line}</p>
</section>

<style>
  .mood { position: relative; background: var(--dark); }
  .mood__media { margin: 0; height: clamp(360px, 56vw, 680px); overflow: hidden; position: relative; }
  .mood__media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; }
  .mood__media::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(0deg, var(--dark), rgb(0 46 43 / 0) 55%); }
  .mood__line {
    position: absolute; z-index: 2; left: 0; right: 0; bottom: clamp(24px, 4vw, 56px);
    font-family: var(--font-display); color: var(--sand); font-size: clamp(2rem, 6vw, 5rem); line-height: 1; max-width: var(--max);
    text-wrap: balance;
  }
  .mood__media[data-placeholder]::after { bottom: auto; top: 12px; }
</style>
