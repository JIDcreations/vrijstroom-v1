---
// Phosphor icons (regular weight), inlined at build time.
interface Props { name: string; size?: number; class?: string }
const { name, size = 24, class: cls } = Astro.props;
const icons = import.meta.glob<string>('/node_modules/@phosphor-icons/core/assets/regular/*.svg', { query: '?raw', import: 'default', eager: true });
const raw = icons[`/node_modules/@phosphor-icons/core/assets/regular/${name}.svg`];
if (!raw) throw new Error(`Icoon "${name}" bestaat niet`);
const svg = raw.replace('<svg', `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false"${cls ? ` class="${cls}"` : ''}`);
---
<Fragment set:html={svg} />
