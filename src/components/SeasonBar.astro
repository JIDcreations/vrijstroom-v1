---
// Season bar: switch on/off with seasonBar.enabled in src/config/site.json.
import site from '../config/site.json';
import Text from './Text.astro';
import Icon from './Icon.astro';
const { enabled, text } = site.seasonBar;
---
{enabled && (
  <div class="season" id="season-bar" data-season-key={text}>
    <p class="container season__inner">
      <span><Text text={text} /> <a href={site.cta.href}>{site.cta.label}</a></span>
      <button type="button" class="season__close" aria-label="Melding sluiten">
        <Icon name="x" size={18} />
      </button>
    </p>
  </div>
)}

<script>
  const bar = document.getElementById('season-bar');
  if (bar) {
    const key = 'vs-season-closed:' + bar.dataset.seasonKey;
    try { if (localStorage.getItem(key)) bar.remove(); } catch {}
    bar.querySelector('button')?.addEventListener('click', () => {
      bar.remove();
      try { localStorage.setItem(key, '1'); } catch {}
    });
  }
</script>

<style>
  .season { background: var(--dark); color: var(--sand); font-size: .9375rem; }
  .season__inner { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 44px; padding-block: 6px; }
  .season a { color: var(--green); font-weight: 600; text-underline-offset: .25em; white-space: nowrap; }
  @media (max-width: 559px) {
    .season { font-size: .875rem; }
    .season a { display: none; }
  }
  .season__close {
    flex: none; display: grid; place-items: center; width: 44px; height: 44px; margin-right: -12px;
    background: none; border: 0; color: var(--sand); cursor: pointer; border-radius: 50%;
  }
  .season__close:focus-visible { outline-color: var(--green); }
</style>
