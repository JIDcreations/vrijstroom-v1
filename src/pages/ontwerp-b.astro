---
// Design direction B: bolder. More Dark nature, the V as a large cut-out frame around the photo.
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Spark from '../components/Spark.astro';
import Icon from '../components/Icon.astro';
import Text from '../components/Text.astro';
import Faq from '../components/Faq.astro';
import site from '../config/site.json';
import c from '../content/home.json';
import { photo } from '../lib/images';
import { faqByIds } from '../lib/faq';
---
<Base title={c.seo.title} description={c.seo.description} headerTone="dark" noindex bodyClass="dir-b">
  <!-- Hero: photo inside a giant V -->
  <section class="hero on-dark">
    <div class="container hero__grid">
      <div class="hero__copy">
        <Spark class="hero__mark" animate />
        <h1>{c.hero.title}</h1>
        <p class="hero__text">{c.hero.text}</p>
        <div class="hero__actions">
          <a class="btn btn--primary btn--lg" href={site.cta.href}>{site.cta.label}</a>
          <a class="btn btn--ghost btn--lg" href={c.hero.secondary.href}>{c.hero.secondary.label}</a>
        </div>
      </div>
    </div>
    <figure class="hero__v" data-placeholder="Sfeerbeeld (stock)">
      <Picture
        src={photo(c.hero.image)}
        alt={c.hero.imageAlt}
        formats={['avif', 'webp']}
        widths={[480, 720, 960, 1280, 1600]}
        sizes="(min-width: 1024px) 60vw, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </figure>
  </section>

  <!-- Pitch on green -->
  <section class="pitch" aria-labelledby="pitch-title">
    <div class="container pitch__inner" data-reveal>
      <h2 id="pitch-title">{c.offer.title}</h2>
      <p>{c.offer.text}</p>
    </div>
  </section>

  <!-- Offer -->
  <section class="offer on-sand" aria-labelledby="offer-title">
    <div class="container">
      <h2 id="offer-title" data-reveal>Wat we inbouwen</h2>
      <ul class="offer__list">
        {c.offer.items.map((item) => (
          <li data-reveal>
            <span class="offer__icon"><Icon name={item.icon} size={28} /></span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </li>
        ))}
        <li class="offer__more" data-reveal>
          <a class="link-arrow" href={c.offer.link.href}>{c.offer.link.label}<Icon name="arrow-right" size={20} /></a>
        </li>
      </ul>
    </div>
  </section>

  <!-- Mood image -->
  <section class="mood" aria-label={c.mood.title}>
    <figure class="mood__media" data-placeholder="Sfeerbeeld (stock)">
      <Picture
        src={photo(c.mood.image)}
        alt={c.mood.imageAlt}
        formats={['avif', 'webp']}
        widths={[640, 960, 1440, 1920]}
        sizes="100vw"
      />
    </figure>
    <p class="container mood__line">{c.mood.title}</p>
  </section>

  <!-- For whom -->
  <section class="who on-dark" aria-labelledby="who-title">
    <div class="container">
      <h2 id="who-title" class="who__title" data-reveal>{c.audiences.title}</h2>
      <div class="who__grid">
        {c.audiences.items.map((a) => (
          <article class="who__col" data-reveal>
            <Icon name={a.icon} size={36} class="who__icon" />
            <p class="who__quote">“{a.quote}”</p>
            <p><Text text={a.quoteNote} /></p>
            <h3>{a.title}</h3>
            <p class="who__text">{a.text}</p>
            <p class="who__mood">{a.mood}</p>
            <a class="btn btn--ghost" href={a.href}>Meer over {a.title.toLowerCase()}</a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Why Vrijstroom -->
  <section class="why on-sand" aria-labelledby="why-title">
    <div class="container">
      <h2 id="why-title" data-reveal>{c.why.title}</h2>
      <ol class="why__list">
        {c.why.items.map((item) => (
          <li data-reveal>
            <Icon name={item.icon} size={32} />
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- The entrepreneur -->
  <section class="founder on-dark" aria-labelledby="founder-title">
    <div class="founder__grid">
      <figure class="founder__media" data-placeholder="Voorbeeldbeeld, geen foto van de ondernemer">
        <Picture
          src={photo(c.founder.image)}
          alt={c.founder.imageAlt}
          formats={['avif', 'webp']}
          widths={[400, 577]}
          sizes="(min-width: 860px) 45vw, 100vw"
        />
      </figure>
      <div class="founder__copy" data-reveal>
        <h2 id="founder-title">{c.founder.title}</h2>
        <p class="founder__name"><Text text={c.founder.name} /></p>
        <p>{c.founder.text}</p>
        <blockquote><Text text={c.founder.quote} /></blockquote>
        <a class="link-arrow" href={c.founder.link.href}>{c.founder.link.label}<Icon name="arrow-right" size={20} /></a>
      </div>
    </div>
  </section>

  <!-- Reviews + FAQ -->
  <section class="trust on-sand" aria-labelledby="faq-title">
    <div class="container trust__grid">
      <div class="reviews" data-reveal>
        <h2 class="reviews__title">{c.reviews.title}</h2>
        <div class="reviews__empty">
          <Icon name="quotes" size={40} />
          <p>{c.reviews.empty}</p>
          <p><Text text={c.reviews.note} /></p>
        </div>
      </div>
      <div>
        <h2 id="faq-title" class="faq__title">{c.faq.title}</h2>
        <Faq items={faqByIds(c.faq.ids)} />
        <a class="link-arrow faq__more" href={c.faq.link.href}>{c.faq.link.label}<Icon name="arrow-right" size={20} /></a>
      </div>
    </div>
  </section>
</Base>

<style>
  .btn--lg { min-height: 56px; font-size: 1.0625rem; padding-inline: 1.7em; }

  /* Hero */
  .hero { position: relative; overflow: hidden; background: var(--dark); color: var(--sand); min-height: min(820px, calc(100dvh - 116px)); display: flex; align-items: center; padding-block: clamp(40px, 6vw, 88px); }
  .hero__grid { position: relative; z-index: 2; width: 100%; }
  .hero__copy { max-width: 600px; }
  .hero__mark { width: 56px; color: var(--green); margin-bottom: 28px; }
  .hero h1 { font-size: clamp(2.5rem, 5.4vw, 4.75rem); line-height: 1.03; max-width: 11ch; }
  .hero__text { margin-top: 24px; font-size: clamp(1.125rem, 1.5vw, 1.25rem); max-width: 36ch; color: var(--muted-on-dark); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 36px; }

  /* The V is the frame: the photo is cut out in the V-shape of the logo */
  .hero__v {
    position: absolute; z-index: 1; margin: 0;
    right: -6vw; top: 50%; translate: 0 -50%;
    width: min(62vw, 980px); aspect-ratio: 374.75 / 294.95;
    -webkit-mask: url('/brand/v-vorm.svg') center / contain no-repeat;
            mask: url('/brand/v-vorm.svg') center / contain no-repeat;
  }
  .hero__v :global(picture), .hero__v :global(img) { width: 100%; height: 100%; }
  .hero__v :global(img) { object-fit: cover; object-position: 50% 55%; }
  .hero__v[data-placeholder]::after { left: 42%; bottom: 8%; }
  @media (prefers-reduced-motion: no-preference) {
    .hero__copy > * { animation: rise .9s var(--ease) both; }
    .hero__copy > :nth-child(2) { animation-delay: .1s; }
    .hero__copy > :nth-child(3) { animation-delay: .18s; }
    .hero__copy > :nth-child(4) { animation-delay: .26s; }
    .hero__v { animation: v-in 1.4s var(--ease) .2s both; }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } }
  @keyframes v-in { from { opacity: 0; transform: translateY(40px) scale(.96); } }

  @media (max-width: 1023px) {
    .hero { flex-direction: column; align-items: stretch; min-height: 0; padding-bottom: 0; }
    .hero__v { position: relative; right: auto; top: auto; translate: none; width: 108vw; margin: 40px 0 40px -4vw; }
    .hero__v[data-placeholder]::after { left: 38%; bottom: 6%; }
  }
  @media (max-width: 480px) {
    .hero__mark { width: 44px; margin-bottom: 20px; }
  }

  /* Pitch */
  .pitch { background: var(--green); color: var(--dark); padding-block: clamp(72px, 9vw, 128px); }
  .pitch__inner { display: grid; gap: 28px; }
  .pitch h2 { font-size: clamp(1.875rem, 4.6vw, 4rem); line-height: 1.06; max-width: 17ch; }
  .pitch p { font-size: clamp(1.0625rem, 1.5vw, 1.25rem); max-width: 56ch; }

  /* Offer */
  .offer { padding-block: var(--section); }
  .offer h2 { font-size: clamp(1.75rem, 3.6vw, 3rem); }
  .offer__list { list-style: none; margin: clamp(40px, 5vw, 64px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .offer__list li { display: grid; gap: 20px; align-content: start; padding: 28px; border-radius: var(--radius); background: var(--sand-2); }
  .offer__list li:first-child { grid-row: span 2; background: var(--dark); color: var(--sand); align-content: end; }
  .offer__list li:first-child h3 { font-size: clamp(1.5rem, 2.4vw, 2rem); }
  .offer__list li:first-child p { color: var(--muted-on-dark); font-size: 1.125rem; }
  .offer__list li:first-child .offer__icon { background: var(--green); color: var(--dark); }
  .offer__icon { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: var(--sand); }
  .offer__list h3 { font-size: 1.1875rem; }
  .offer__list p { margin-top: 8px; color: var(--muted); }
  .offer__more { background: transparent !important; border: 1.5px solid var(--line); align-content: center !important; }
  @media (max-width: 859px) {
    .offer__list { grid-template-columns: 1fr 1fr; }
    .offer__list li:first-child { grid-row: auto; grid-column: 1 / -1; }
  }
  @media (max-width: 560px) { .offer__list { grid-template-columns: 1fr; } }

  /* Mood */
  .mood { position: relative; background: var(--dark); }
  .mood__media { margin: 0; height: clamp(360px, 56vw, 680px); overflow: hidden; position: relative; }
  .mood__media :global(picture), .mood__media :global(img) { width: 100%; height: 100%; }
  .mood__media :global(img) { object-fit: cover; object-position: 50% 60%; }
  .mood__media::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(0deg, var(--dark), rgb(0 46 43 / 0) 55%); }
  .mood__line {
    position: absolute; z-index: 2; left: 0; right: 0; bottom: clamp(24px, 4vw, 56px);
    font-family: var(--font-display); color: var(--sand); font-size: clamp(2rem, 6vw, 5rem); line-height: 1;
  }

  /* Who */
  .who { background: var(--dark); color: var(--sand); padding-block: clamp(56px, 7vw, 96px) var(--section); }
  .who__title { font-size: clamp(1.75rem, 3.6vw, 3rem); max-width: 18ch; }
  .who__grid { display: grid; grid-template-columns: 1fr 1fr; margin-top: clamp(40px, 5vw, 72px); border-top: 1px solid var(--line-on-dark); }
  .who__col { display: grid; gap: 14px; align-content: start; justify-items: start; padding: clamp(32px, 4vw, 56px) clamp(0px, 4vw, 56px) 0 0; }
  .who__col + .who__col { border-left: 1px solid var(--line-on-dark); padding-left: clamp(24px, 4vw, 56px); }
  .who__col :global(.who__icon) { color: var(--green); }
  .who__quote { font-family: var(--font-display); color: var(--green); font-size: clamp(1.375rem, 2.4vw, 2rem); line-height: 1.2; }
  .who__col h3 { font-size: 1.25rem; margin-top: 16px; }
  .who__text { color: var(--muted-on-dark); max-width: 44ch; }
  .who__mood { font-style: italic; margin-bottom: 12px; }
  @media (max-width: 859px) {
    .who__grid { grid-template-columns: 1fr; }
    .who__col { padding-right: 0; }
    .who__col + .who__col { border-left: 0; border-top: 1px solid var(--line-on-dark); padding-left: 0; margin-top: 40px; }
  }

  /* Why */
  .why { padding-block: var(--section); }
  .why h2 { font-size: clamp(1.75rem, 3.6vw, 3rem); max-width: 16ch; }
  .why__list { list-style: none; margin: clamp(40px, 5vw, 72px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px 32px; }
  .why__list li { display: grid; gap: 12px; align-content: start; padding-top: 28px; border-top: 3px solid var(--dark); }
  .why__list h3 { font-size: 1.1875rem; margin-top: 4px; }
  .why__list p { color: var(--muted); }
  @media (max-width: 1023px) { .why__list { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .why__list { grid-template-columns: 1fr; } }

  /* Founder */
  .founder { background: var(--dark); color: var(--sand); }
  .founder__grid { display: grid; grid-template-columns: 1fr 1fr; align-items: center; }
  .founder__media { margin: 0; aspect-ratio: 4 / 5; max-height: 820px; width: 100%; overflow: hidden; }
  .founder__media :global(picture), .founder__media :global(img) { width: 100%; height: 100%; }
  .founder__media :global(img) { object-fit: cover; object-position: 50% 35%; }
  .founder__copy { display: grid; gap: 18px; justify-items: start; padding: clamp(48px, 7vw, 112px) var(--gutter); max-width: 620px; }
  .founder h2 { font-size: clamp(1.75rem, 3.2vw, 2.625rem); }
  .founder__name { font-weight: 600; }
  .founder__copy > p:not(.founder__name) { color: var(--muted-on-dark); }
  .founder blockquote { margin: 8px 0; padding-left: 20px; border-left: 3px solid var(--green); font-family: var(--font-display); font-size: 1.25rem; line-height: 1.35; }
  @media (max-width: 859px) {
    .founder__grid { grid-template-columns: 1fr; }
    .founder__media { aspect-ratio: 4 / 3; }
  }

  /* Reviews + FAQ */
  .trust { padding-block: var(--section); }
  .trust__grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
  .reviews__title, .faq__title { font-size: clamp(1.5rem, 3vw, 2.25rem); margin-bottom: 28px; }
  .reviews__empty { display: grid; gap: 10px; justify-items: start; padding: clamp(28px, 4vw, 40px); border-radius: var(--radius); background: var(--sand-2); }
  .reviews__empty p:first-of-type { font-size: 1.125rem; font-weight: 600; }
  .faq__more { margin-top: 16px; }
  @media (max-width: 859px) { .trust__grid { grid-template-columns: 1fr; } }
</style>
