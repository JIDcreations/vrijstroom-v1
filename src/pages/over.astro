---
// Over Vrijstroom: the entrepreneur, the approach, projects. Texts: src/content/over.json
import Base from '../layouts/Base.astro';
import VHero from '../components/VHero.astro';
import PitchBand from '../components/PitchBand.astro';
import FounderSplit from '../components/FounderSplit.astro';
import WhyList from '../components/WhyList.astro';
import FaqSection from '../components/FaqSection.astro';
import Spark from '../components/Spark.astro';
import Text from '../components/Text.astro';
import BrandStrip from '../components/BrandStrip.astro';
import c from '../content/over.json';

type Project = { title: string; start: string; approach: string; result: string };
const projects = c.projects.items as Project[];
---
<Base title={c.seo.title} description={c.seo.description} headerTone="dark">
  <VHero title={c.hero.title} text={c.hero.text} image={c.hero.image} imageAlt={c.hero.imageAlt} />

  <PitchBand title={c.mission.title} text={c.mission.text} id="mission-title" />

  <FounderSplit
    title={c.founder.title}
    name={c.founder.name}
    paragraphs={c.founder.paragraphs}
    quote={c.founder.quote}
    image={c.founder.image}
    imageAlt={c.founder.imageAlt}
    imageNote={c.founder.imageNote}
  />

  <WhyList title={c.approach.title} id="approach-title" />

  <!-- Projects: start -> approach -> result. Empty until there are real cases. -->
  <section class="projects on-sand" aria-labelledby="projects-title">
    <div class="container">
      <h2 id="projects-title" data-reveal>{c.projects.title}</h2>
      <p class="projects__intro" data-reveal>{c.projects.intro}</p>
      {projects.length === 0 ? (
        <div class="projects__empty" data-reveal>
          <Spark class="projects__spark" />
          <p>{c.projects.empty}</p>
        </div>
      ) : (
        <ul class="projects__list">
          {projects.map((p) => (
            <li class="project">
              <h3>{p.title}</h3>
              <dl>
                <div><dt>Vertrekpunt</dt><dd><Text text={p.start} /></dd></div>
                <div><dt>Aanpak</dt><dd><Text text={p.approach} /></dd></div>
                <div><dt>Resultaat</dt><dd><Text text={p.result} /></dd></div>
              </dl>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  {c.brands.enabled && <BrandStrip tone="sand-2" />}

  <FaqSection ids={c.faq} />
</Base>

<style>
  .projects { padding-bottom: var(--section); }
  .projects h2 { font-size: clamp(1.75rem, 3.6vw, 3rem); }
  .projects__intro { margin-top: 16px; max-width: 56ch; color: var(--muted); }
  .projects__empty {
    position: relative; overflow: hidden; margin-top: clamp(32px, 4vw, 48px);
    min-height: 240px; display: grid; align-content: center;
    padding: clamp(32px, 5vw, 64px); border-radius: var(--radius); background: var(--dark); color: var(--sand);
  }
  .projects__empty p { position: relative; z-index: 1; font-family: var(--font-display); font-size: clamp(1.5rem, 3vw, 2.25rem); max-width: 16ch; line-height: 1.15; }
  .projects__spark { position: absolute; right: -60px; top: 50%; translate: 0 -50%; width: 340px; color: var(--green); opacity: .14; }
  .projects__list { list-style: none; margin: 40px 0 0; padding: 0; display: grid; gap: 16px; }
  .project { padding: 32px; border-radius: var(--radius); background: var(--sand-2); }
  .project dl { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; margin: 20px 0 0; }
  .project dt { font-weight: 600; }
  .project dd { margin: 4px 0 0; color: var(--muted); }
  @media (max-width: 760px) { .project dl { grid-template-columns: 1fr; } }

  .brands { padding-bottom: var(--section); }
  .brands h2 { font-size: clamp(1.5rem, 3vw, 2.25rem); }
  .brands__list { list-style: none; margin: 32px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 40px; align-items: center; }
  .brands__list img { height: 48px; width: auto; }
</style>
