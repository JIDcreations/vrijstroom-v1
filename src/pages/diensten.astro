---
// Diensten: all services with technical explanation, packages, prices, process, warranty and calculator.
// Texts: src/content/diensten.json
import Base from '../layouts/Base.astro';
import VHero from '../components/VHero.astro';
import Calculator from '../components/Calculator.astro';
import DoubtNote from '../components/DoubtNote.astro';
import FaqSection from '../components/FaqSection.astro';
import Icon from '../components/Icon.astro';
import Text from '../components/Text.astro';
import ProblemList from '../components/ProblemList.astro';
import c from '../content/diensten.json';
---
<Base title={c.seo.title} description={c.seo.description} headerTone="dark">
  <VHero title={c.hero.title} text={c.hero.text} image={c.hero.image} imageAlt={c.hero.imageAlt} secondary={{ label: 'Bereken wat je nodig hebt', href: '#rekentool', icon: 'calculator' }} />

  <!-- Services -->
  <section class="services on-sand" aria-labelledby="services-title">
    <div class="container services__grid">
      <div class="services__aside">
        <h2 id="services-title">{c.services.title}</h2>
        <p class="services__intro">{c.services.intro}</p>
        <nav aria-label="Diensten op deze pagina" class="services__toc">
          <ul>
            {c.services.items.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
            <li><a href="#rekentool" class="services__toc-calc"><Icon name="calculator" size={20} />Hoeveel stroom heb ik nodig?</a></li>
          </ul>
        </nav>
      </div>
      <div class="services__list">
        {c.services.items.map((s) => (
          <article class="service" id={s.id} data-reveal>
            <span class="service__icon"><Icon name={s.icon} size={28} /></span>
            <h3>{s.title}</h3>
            <p class="service__benefit">{s.benefit}</p>
            <p class="service__text"><Text text={s.text} /></p>
            {s.price && <p class="service__price"><Text text={s.price} /></p>}
            {s.link && <a class="link-arrow" href={s.link.href}>{s.link.label}<Icon name="arrow-right" size={20} /></a>}
            {s.doubt && <DoubtNote id={s.doubt} />}
          </article>
        ))}
      </div>
    </div>
  </section>

  <Calculator />

  <ProblemList title={c.problems.title} intro={c.problems.intro} items={c.problems.items} />

  <!-- Packages -->
  {c.packages.enabled && (
    <section class="packages on-sand" aria-labelledby="packages-title">
      <div class="container">
        <h2 id="packages-title" data-reveal>{c.packages.title}</h2>
        <p class="packages__intro" data-reveal>{c.packages.intro}</p>
        <ul class="packages__list">
          {c.packages.items.map((p) => (
            <li class="package" data-reveal>
              <h3><Text text={p.name} /></h3>
              <p class="package__for"><Text text={p.for} /></p>
              <ul class="package__contents">
                {p.contents.map((item) => <li><Icon name="check" size={18} /><span><Text text={item} /></span></li>)}
              </ul>
              <p class="package__price"><Text text={p.price} /></p>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Price transparency -->
  <section class="pricing" aria-labelledby="pricing-title">
    <div class="container">
      <h2 id="pricing-title" data-reveal>{c.pricing.title}</h2>
      <div class="pricing__cols">
        {c.pricing.columns.map((col) => (
          <div class="pricing__col" data-reveal>
            <Icon name={col.icon} size={32} />
            <h3>{col.title}</h3>
            <ul>
              {col.items.map((item) => <li><Text text={item} /></li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="process on-dark" aria-labelledby="process-title">
    <div class="container">
      <h2 id="process-title" data-reveal>{c.process.title}</h2>
      <ol class="process__steps">
        {c.process.steps.map((step) => (
          <li data-reveal>
            <h3>{step.title}</h3>
            <p><Text text={step.text} /></p>
          </li>
        ))}
      </ol>
      <p class="process__note" data-reveal><Icon name="map-pin" size={22} /><span>{c.process.note}</span></p>
      <div class="process__doubt" data-reveal>
        <DoubtNote id={c.process.doubt} tone="dark" />
      </div>
    </div>
  </section>

  <!-- Warranty (switch on in diensten.json once the terms are known) -->
  {c.warranty.enabled && (<section class="warranty on-sand" aria-labelledby="warranty-title">
    <div class="container">
      <div class="warranty__inner" data-reveal>
        <h2 id="warranty-title">{c.warranty.title}</h2>
        <ul class="warranty__list">
          {c.warranty.items.map((w) => (
            <li><Icon name={w.icon} size={32} /><p><strong>{w.title}</strong> {w.text}</p></li>
          ))}
        </ul>
      </div>
    </div>
  </section>)}

  <FaqSection ids={c.faq} />
</Base>

<style>
  /* Services */
  .services { padding-block: var(--section); }
  .services__grid { display: grid; grid-template-columns: 1fr 1.7fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
  .services__aside { position: sticky; top: 104px; }
  .services h2 { font-size: clamp(1.75rem, 3.6vw, 3rem); }
  .services__intro { margin-top: 16px; color: var(--muted); max-width: 40ch; }
  .services__toc ul { list-style: none; margin: 28px 0 0; padding: 0; display: grid; }
  .services__toc a { display: flex; align-items: center; min-height: 40px; font-weight: 600; text-decoration: none; border-bottom: 1px solid var(--line); }
  .services__toc a:hover { text-decoration: underline; text-underline-offset: .3em; }
  .services__toc .services__toc-calc { gap: 8px; margin-top: 12px; border-bottom: 0; }
  .services__list { display: grid; gap: 0; }
  .service { display: grid; gap: 12px; justify-items: start; padding-block: 40px; border-top: 1px solid var(--line); scroll-margin-top: 96px; }
  .service:first-child { border-top: 0; padding-top: 0; }
  .service__icon { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; background: var(--dark); color: var(--green); }
  .service h3 { font-size: clamp(1.375rem, 2.2vw, 1.75rem); margin-top: 8px; }
  .service__benefit { font-size: 1.1875rem; font-weight: 600; }
  .service__text { color: var(--muted); max-width: 60ch; }
  .service__price { display: inline-block; padding: 6px 14px; border-radius: var(--pill); background: var(--sand-2); font-weight: 600; font-size: .9375rem; }
  .service :global(.doubt) { margin-top: 8px; width: 100%; }
  @media (max-width: 959px) {
    .services__grid { grid-template-columns: 1fr; }
    .services__aside { position: static; }
    .services__toc { display: none; }
  }

  /* Packages */
  .packages { padding-block: var(--section); background: var(--sand-2); }
  .packages h2 { font-size: clamp(1.75rem, 3.6vw, 3rem); }
  .packages__intro { margin-top: 16px; max-width: 56ch; color: var(--muted); }
  .packages__list { list-style: none; margin: clamp(32px, 4vw, 56px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .package { display: grid; gap: 14px; align-content: start; padding: clamp(24px, 3vw, 36px); border-radius: var(--radius); background: var(--sand); }
  .package:nth-child(2) { background: var(--dark); color: var(--sand); }
  .package h3 { font-size: 1.25rem; }
  .package__for { color: var(--muted); }
  .package:nth-child(2) .package__for { color: var(--muted-on-dark); }
  .package__contents { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .package__contents li { display: flex; gap: 10px; align-items: flex-start; }
  .package__contents li :global(svg) { flex: none; margin-top: 3px; }
  .package__price { margin-top: 8px; padding-top: 16px; border-top: 1px solid var(--line); font-family: var(--font-display); font-size: 1.125rem; }
  .package:nth-child(2) .package__price { border-color: var(--line-on-dark); }
  @media (max-width: 859px) { .packages__list { grid-template-columns: 1fr; } }

  /* Pricing */
  .pricing { padding-block: clamp(72px, 9vw, 128px); background: var(--green); color: var(--dark); }
  .pricing h2 { font-size: clamp(1.75rem, 3.6vw, 3rem); max-width: 20ch; }
  .pricing__cols { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px 32px; margin-top: clamp(40px, 5vw, 64px); }
  .pricing__col { display: grid; gap: 12px; align-content: start; padding-top: 28px; border-top: 3px solid var(--dark); }
  .pricing__col h3 { font-size: 1.25rem; }
  .pricing__col ul { margin: 0; padding-left: 1.1em; display: grid; gap: 6px; }
  .pricing :focus-visible { outline-color: var(--dark); }
  @media (max-width: 859px) { .pricing__cols { grid-template-columns: 1fr; } }

  /* Process */
  .process { padding-block: var(--section); background: var(--dark); color: var(--sand); }
  .process h2 { font-size: clamp(1.75rem, 3.6vw, 3rem); }
  .process__steps { list-style: none; margin: clamp(40px, 5vw, 72px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 32px; counter-reset: step; }
  .process__steps li { position: relative; display: grid; gap: 12px; align-content: start; padding-top: 40px; counter-increment: step; }
  .process__steps li::before {
    content: counter(step); position: absolute; top: 0; left: 0;
    display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%;
    background: var(--green); color: var(--dark); font: 600 .875rem/1 var(--font-body);
  }
  .process__steps li::after { content: ''; position: absolute; top: 13px; left: 40px; right: -20px; height: 2px; background: var(--line-on-dark); }
  .process__steps li:last-child::after { display: none; }
  .process__steps h3 { font-size: 1.375rem; }
  .process__steps p { color: var(--muted-on-dark); }
  .process__note { display: flex; gap: 12px; align-items: flex-start; margin-top: clamp(40px, 5vw, 64px); max-width: 720px; color: var(--muted-on-dark); }
  .process__note :global(svg) { flex: none; color: var(--green); margin-top: 2px; }
  .process__doubt { margin-top: 24px; max-width: 720px; }
  @media (max-width: 959px) {
    .process__steps { grid-template-columns: 1fr 1fr; }
    .process__steps li::after { display: none; }
  }
  @media (max-width: 560px) { .process__steps { grid-template-columns: 1fr; } }

  /* Warranty */
  .warranty { padding-top: var(--section); }
  .warranty__inner { display: grid; gap: 28px; padding: clamp(28px, 4vw, 48px); border-radius: var(--radius); border: 1.5px solid var(--line); }
  .warranty h2 { font-size: clamp(1.5rem, 3vw, 2.25rem); }
  .warranty__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px 32px; }
  .warranty__list li { display: grid; gap: 12px; align-content: start; }
  .warranty__list p { color: var(--muted); }
  .warranty__list strong { display: block; color: var(--dark); font-size: 1.125rem; }
  @media (max-width: 859px) { .warranty__list { grid-template-columns: 1fr; } }
</style>
