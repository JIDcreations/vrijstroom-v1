---
// Design direction A: calm and spacious. Lots of Soft sand, the icon as a quiet image element.
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Spark from '../components/Spark.astro';
import Icon from '../components/Icon.astro';
import Text from '../components/Text.astro';
import Faq from '../components/Faq.astro';
import site from '../config/site.json';
import c from '../content/home.json';
import { photo } from '../lib/images';
---
<Base title={c.seo.title} description={c.seo.description} noindex bodyClass="dir-a">
  <!-- Hero: a feeling, not an explanation -->
  <section class="hero on-sand">
    <Spark class="hero__spark" animate />
    <div class="container hero__grid">
      <div class="hero__copy">
        <h1>{c.hero.title}</h1>
        <p class="hero__text">{c.hero.text}</p>
        <div class="hero__actions">
          <a class="btn btn--primary btn--lg" href={site.cta.href}>{site.cta.label}</a>
          <a class="link-arrow" href={c.hero.secondary.href}>{c.hero.secondary.label}<Icon name="arrow-right" size={20} /></a>
        </div>
      </div>
      <figure class="hero__media" data-placeholder="Sfeerbeeld (stock)">
        <Picture
          src={photo(c.hero.image)}
          alt={c.hero.imageAlt}
          formats={['avif', 'webp']}
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1024px) 46vw, 100vw"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <!-- Short offer -->
  <section class="offer" aria-labelledby="offer-title">
    <div class="container">
      <div class="offer__head" data-reveal>
        <h2 id="offer-title">{c.offer.title}</h2>
        <p>{c.offer.text}</p>
      </div>
      <ul class="offer__list">
        {c.offer.items.map((item) => (
          <li data-reveal>
            <Icon name={item.icon} size={32} />
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
      <a class="link-arrow" href={c.offer.link.href}>{c.offer.link.label}<Icon name="arrow-right" size={20} /></a>
    </div>
  </section>

  <!-- For whom -->
  <section class="who" aria-labelledby="who-title">
    <div class="container">
      <h2 id="who-title" class="who__title" data-reveal>{c.audiences.title}</h2>
      <div class="who__grid">
        {c.audiences.items.map((a) => (
          <article class="who__card" data-reveal>
            <p class="who__quote">“{a.quote}”</p>
            <p class="who__note"><Text text={a.quoteNote} /></p>
            <h3><Icon name={a.icon} size={28} />{a.title}</h3>
            <p>{a.text}</p>
            <p class="who__mood">{a.mood}</p>
            <a class="link-arrow" href={a.href}>Meer over {a.title.toLowerCase()}<Icon name="arrow-right" size={20} /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Mood image with one line -->
  <section class="mood" aria-label={c.mood.title}>
    <figure class="mood__media" data-placeholder="Sfeerbeeld (stock)">
      <Picture
        src={photo(c.mood.image)}
        alt={c.mood.imageAlt}
        formats={['avif', 'webp']}
        widths={[640, 960, 1440, 1920]}
        sizes="100vw"
      />
      <figcaption class="container"><span>{c.mood.title}</span></figcaption>
    </figure>
  </section>

  <!-- Why Vrijstroom -->
  <section class="why" aria-labelledby="why-title">
    <div class="container why__grid">
      <h2 id="why-title" data-reveal>{c.why.title}</h2>
      <ul>
        {c.why.items.map((item) => (
          <li data-reveal>
            <Icon name={item.icon} size={28} />
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- The entrepreneur -->
  <section class="founder" aria-labelledby="founder-title">
    <div class="container founder__grid">
      <figure class="founder__media" data-placeholder="Voorbeeldbeeld, geen foto van de ondernemer">
        <Picture
          src={photo(c.founder.image)}
          alt={c.founder.imageAlt}
          formats={['avif', 'webp']}
          widths={[400, 577]}
          sizes="(min-width: 860px) 34vw, 90vw"
        />
      </figure>
      <div class="founder__copy" data-reveal>
        <h2 id="founder-title">{c.founder.title}</h2>
        <p class="founder__name"><Text text={c.founder.name} /></p>
        <p>{c.founder.text}</p>
        <blockquote><Text text={c.founder.quote} /></blockquote>
        <a class="link-arrow" href={c.founder.link.href}>{c.founder.link.label}<Icon name="arrow-right" size={20} /></a>
      </div>
    </div>
  </section>

  <!-- Reviews: room for real Google reviews -->
  <section class="reviews" aria-labelledby="reviews-title">
    <div class="container reviews__inner" data-reveal>
      <h2 id="reviews-title">{c.reviews.title}</h2>
      <div class="reviews__empty">
        <Spark class="reviews__spark" />
        <p>{c.reviews.empty}</p>
        <p><Text text={c.reviews.note} /></p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="faq-block" aria-labelledby="faq-title">
    <div class="container faq-block__grid">
      <div>
        <h2 id="faq-title">{c.faq.title}</h2>
        <a class="link-arrow" href={c.faq.link.href}>{c.faq.link.label}<Icon name="arrow-right" size={20} /></a>
      </div>
      <Faq items={c.faq.items} />
    </div>
  </section>
</Base>

<style>
  .btn--lg { min-height: 56px; font-size: 1.0625rem; padding-inline: 1.7em; }

  /* Hero */
  .hero { position: relative; overflow: hidden; padding-block: clamp(32px, 6vw, 88px) clamp(64px, 8vw, 112px); }
  .hero__spark {
    position: absolute; z-index: 0; color: var(--dark); opacity: .06; pointer-events: none;
    width: clamp(420px, 52vw, 820px); left: -14%; top: 52%;
  }
  .hero__grid { position: relative; z-index: 1; display: grid; grid-template-columns: 1fr 1.05fr; gap: clamp(32px, 6vw, 96px); align-items: center; }
  .hero h1 { font-size: clamp(2.375rem, 5.6vw, 4.75rem); line-height: 1.04; max-width: 11ch; }
  .hero__text { margin-top: 24px; font-size: clamp(1.125rem, 1.6vw, 1.3125rem); max-width: 34ch; color: var(--muted); }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 28px; margin-top: 36px; }
  .hero__media { margin: 0; border-radius: var(--radius); overflow: hidden; aspect-ratio: 4 / 5; }
  .hero__media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; }
  @media (prefers-reduced-motion: no-preference) {
    .hero__copy > * { animation: rise .9s var(--ease) both; }
    .hero__copy > :nth-child(2) { animation-delay: .08s; }
    .hero__copy > :nth-child(3) { animation-delay: .16s; }
    .hero__media { animation: fade 1.2s var(--ease) .1s both; }
  }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } }
  @keyframes fade { from { opacity: 0; transform: scale(1.02); } }
  @media (max-width: 859px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__media { aspect-ratio: 4 / 3; order: -1; }
    .hero__spark { top: auto; bottom: -30%; left: auto; right: -40%; width: 120vw; }
  }

  /* Offer */
  .offer { padding-block: var(--section); }
  .offer__head { max-width: 760px; }
  .offer h2 { font-size: clamp(1.75rem, 3.6vw, 3rem); }
  .offer__head p { margin-top: 20px; max-width: 58ch; color: var(--muted); font-size: 1.125rem; }
  .offer__list {
    list-style: none; margin: clamp(48px, 6vw, 80px) 0 40px; padding: 0;
    display: grid; grid-template-columns: repeat(6, 1fr); gap: 48px 40px;
  }
  .offer__list li { grid-column: span 2; display: grid; gap: 10px; align-content: start; padding-top: 24px; border-top: 1px solid var(--line); }
  .offer__list li:nth-child(4), .offer__list li:nth-child(5) { grid-column: span 3; }
  .offer__list h3 { font-size: 1.1875rem; margin-top: 6px; }
  .offer__list p { color: var(--muted); max-width: 40ch; }
  @media (max-width: 859px) {
    .offer__list { grid-template-columns: 1fr 1fr; gap: 36px 24px; }
    .offer__list li, .offer__list li:nth-child(4), .offer__list li:nth-child(5) { grid-column: auto; }
  }
  @media (max-width: 560px) { .offer__list { grid-template-columns: 1fr; } }

  /* Who */
  .who { padding-block: var(--section); background: var(--sand-2); }
  .who__title { font-size: clamp(1.75rem, 3.6vw, 3rem); max-width: 18ch; }
  .who__grid { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(20px, 3vw, 40px); margin-top: clamp(40px, 5vw, 64px); }
  .who__card { background: var(--sand); border-radius: var(--radius); padding: clamp(28px, 4vw, 56px); display: grid; gap: 14px; align-content: start; }
  .who__quote { font-family: var(--font-display); font-size: clamp(1.25rem, 2.2vw, 1.75rem); line-height: 1.25; letter-spacing: -0.01em; }
  .who__note { margin-top: -4px; }
  .who__card h3 { display: flex; align-items: center; gap: 10px; font-size: 1.25rem; margin-top: 20px; padding-top: 24px; border-top: 1px solid var(--line); }
  .who__card > p:not(.who__quote, .who__note, .who__mood) { color: var(--muted); }
  .who__mood { font-style: italic; }
  @media (max-width: 859px) { .who__grid { grid-template-columns: 1fr; } }

  /* Mood */
  .mood__media { position: relative; margin: 0; height: clamp(360px, 62vw, 720px); overflow: hidden; }
  .mood__media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 60%; }
  .mood__media::before { content: ''; position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgb(0 46 43 / .55), rgb(0 46 43 / 0) 45%); }
  .mood figcaption { position: absolute; z-index: 2; inset: 0; margin-inline: auto; padding-top: clamp(32px, 6vw, 80px); }
  .mood figcaption span { display: block; font-family: var(--font-display); color: var(--sand); font-size: clamp(2rem, 5vw, 4rem); line-height: 1.05; max-width: 12ch; }

  /* Why */
  .why { padding-block: var(--section); }
  .why__grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: clamp(40px, 6vw, 96px); align-items: start; }
  .why h2 { font-size: clamp(1.75rem, 3.6vw, 3rem); position: sticky; top: 120px; }
  .why ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 48px 40px; }
  .why li { display: grid; gap: 10px; align-content: start; }
  .why h3 { font-size: 1.1875rem; margin-top: 6px; }
  .why li p { color: var(--muted); }
  @media (max-width: 859px) {
    .why__grid { grid-template-columns: 1fr; }
    .why h2 { position: static; }
  }
  @media (max-width: 560px) { .why ul { grid-template-columns: 1fr; gap: 36px; } }

  /* Founder */
  .founder { padding-bottom: var(--section); }
  .founder__grid { display: grid; grid-template-columns: .8fr 1fr; gap: clamp(40px, 7vw, 112px); align-items: center; }
  .founder__media { margin: 0; border-radius: var(--radius); overflow: hidden; aspect-ratio: 4 / 5; }
  .founder__media :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 50% 30%; }
  .founder__copy { display: grid; gap: 18px; justify-items: start; max-width: 52ch; }
  .founder h2 { font-size: clamp(1.75rem, 3.2vw, 2.625rem); }
  .founder__name { font-weight: 600; }
  .founder blockquote { margin: 8px 0; padding-left: 20px; border-left: 3px solid var(--dark); font-family: var(--font-display); font-size: 1.25rem; line-height: 1.35; }
  @media (max-width: 859px) {
    .founder__grid { grid-template-columns: 1fr; }
    .founder__media { max-width: 420px; }
  }

  /* Reviews */
  .reviews { padding-block: clamp(64px, 8vw, 112px); background: var(--sand-2); }
  .reviews__inner { display: grid; gap: 32px; }
  .reviews h2 { font-size: clamp(1.5rem, 3vw, 2.25rem); }
  .reviews__empty {
    position: relative; overflow: hidden; display: grid; gap: 8px; justify-items: start;
    padding: clamp(28px, 4vw, 48px); border: 1.5px dashed rgb(0 46 43 / .35); border-radius: var(--radius);
  }
  .reviews__empty p:first-of-type { font-size: 1.125rem; font-weight: 600; }
  .reviews__spark { position: absolute; right: -40px; top: 50%; translate: 0 -50%; width: 200px; color: var(--dark); opacity: .06; }

  /* FAQ */
  .faq-block { padding-block: var(--section); }
  .faq-block__grid { display: grid; grid-template-columns: 1fr 1.5fr; gap: clamp(32px, 6vw, 96px); align-items: start; }
  .faq-block h2 { font-size: clamp(1.5rem, 3vw, 2.25rem); margin-bottom: 16px; }
  @media (max-width: 859px) { .faq-block__grid { grid-template-columns: 1fr; } }
</style>
