---
// Fase 1: keuzepagina tussen twee designrichtingen. Wordt in fase 2 de echte homepage.
import '../styles/global.css';
import Spark from '../components/Spark.astro';
---
<!doctype html>
<html lang="nl-BE">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Vrijstroom | Kies een designrichting</title>
    <link rel="icon" type="image/svg+xml" href="/brand/icoon-diep.svg" />
  </head>
  <body class="pick on-dark">
    <main class="container">
      <Spark class="pick__spark" animate />
      <h1>Vrijstroom homepage: twee richtingen</h1>
      <ul>
        <li><a href="/ontwerp-a"><strong>A. Rustig en ruim</strong><span>Veel Soft sand, het icoon als subtiel beeldelement.</span></a></li>
        <li><a href="/ontwerp-b"><strong>B. Krachtig</strong><span>Meer Dark nature, de V als groot uitgesneden kader rond beeld.</span></a></li>
      </ul>
    </main>
    <style>
      .pick { background: var(--dark); color: var(--sand); min-height: 100dvh; display: grid; place-items: center; }
      .pick main { max-width: 760px; padding-block: 64px; }
      .pick__spark { width: 72px; color: var(--green); margin-bottom: 32px; }
      h1 { font-size: clamp(1.75rem, 4vw, 2.75rem); }
      ul { list-style: none; padding: 0; margin: 40px 0 0; display: grid; gap: 16px; }
      a { display: grid; gap: 6px; padding: 28px; border: 1px solid var(--line-on-dark); border-radius: var(--radius); text-decoration: none; transition: background-color .2s; }
      a:hover { background: var(--dark-80); }
      strong { font-family: var(--font-display); font-weight: 600; font-size: 1.25rem; color: var(--green); }
      span { color: var(--muted-on-dark); }
    </style>
  </body>
</html>
